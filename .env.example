# Hermes Control Panel credentials.
# Copy to /etc/hermes-panel.env, fill in, then chmod 600.
#   sudo install -m 600 -o root -g root .env.example /etc/hermes-panel.env
# NEVER commit the filled-in copy. /etc is outside this repo on purpose.

# Port the panel listens on.
PANEL_PORT=9120

# Login password for the /login form (required).
PANEL_PASSWORD=

# Override the Hermes config path (default: /root/.hermes/config.yaml).
# HERMES_CONFIG_PATH=/root/.hermes/config.yaml

# Force the 9router host instead of auto-probing.
# ROUTER_HOST=127.0.0.1
