[Unit]
Description=Hermes Control Panel
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/AppData/hermes-native/hermes-data/scripts/dashboard-toggle-server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Credentials live in a 0600 file outside the repo — never in this unit, never
# committed. Copy .env.example to /etc/hermes-panel.env and fill it in.
EnvironmentFile=/etc/hermes-panel.env

[Install]
WantedBy=multi-user.target
